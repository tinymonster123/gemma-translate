{
  "name": "gemma-translate",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "本地 Gemma 4 整页翻译扩展。WXT + React + TypeScript。",
  "scripts": {
    "prepare": "wxt prepare",
    "prepare:ort": "node scripts/copy-ort.mjs",
    "predev": "npm run prepare:ort",
    "dev": "wxt",
    "prebuild": "npm run prepare:ort",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "probe": "npm run build && node probes/flow-verify.mjs",
    "perf": "npm run build && node probes/perf-trace.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
